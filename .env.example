# Twitch: https://dev.twitch.tv/console/apps (app "Confidential", client credentials)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Claude (opcional, para nota/título): https://console.anthropic.com
ANTHROPIC_API_KEY=

# YouTube: OAuth client "Desktop app" no Google Cloud, com YouTube Data API v3 ativada
YOUTUBE_CLIENT_SECRETS=secrets/youtube_client_secret.json

# TikTok: app em https://developers.tiktok.com com Login Kit + Content Posting API
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=

# Instagram (Reels): app em developers.facebook.com com o produto Instagram (Facebook Login for Business)
META_APP_ID=
META_APP_SECRET=
